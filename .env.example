# Required only for a live send. Dry runs do not require credentials.
# Shopify Admin API credentials are required for Shopify-backed automation.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SEEDHIBAAT_DEFAULT_COUNTRY_CODE=

META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Optional second profile. The daemon accepts inbound callbacks from both the
# active and test phone IDs, while outbound sends always use the active ID.
WHATSAPP_TEST_PHONE_NUMBER_ID=
WHATSAPP_TEST_BUSINESS_ACCOUNT_ID=
META_GRAPH_API_VERSION=v23.0
META_WEBHOOK_VERIFY_TOKEN=

# SeedhiBaat daemon. Generate every *_KEY/TOKEN value independently with a
# cryptographically secure password generator; never reuse provider secrets.
SEEDHIBAAT_LISTEN_ADDR=127.0.0.1:8088
SEEDHIBAAT_PUBLIC_BASE_URL=https://wa.example.com
SEEDHIBAAT_REDIRECT_ALLOWED_HOSTS=example.com,www.example.com
SEEDHIBAAT_DATABASE_PATH=state/seedhibaat.db
SEEDHIBAAT_WORKFLOW_DIR=config/workflows
SEEDHIBAAT_API_KEY=
SEEDHIBAAT_PII_HASH_KEY=
SEEDHIBAAT_LINK_SIGNING_KEY=
SEEDHIBAAT_BACKUP_KEY=
SEEDHIBAAT_BACKUP_DIR=backups
SEEDHIBAAT_WORKER_CONCURRENCY=4
SEEDHIBAAT_WORKER_POLL_INTERVAL=1s
SEEDHIBAAT_RECONCILE_INTERVAL=6h
SEEDHIBAAT_INITIAL_SYNC_LOOKBACK=17520h
SEEDHIBAAT_RECONCILE_OVERLAP=24h
SEEDHIBAAT_RETENTION_DAYS=365
SEEDHIBAAT_ATTRIBUTION_WINDOW=720h
SEEDHIBAAT_REPORT_TIMEZONE=UTC

# Optional read-only aggregate dashboard. This exposes no send controls or PII.
SEEDHIBAAT_METRICS_ENABLED=false
SEEDHIBAAT_METRICS_USERNAME=operator
SEEDHIBAAT_METRICS_PASSWORD=

# Safety gates default off. Turning these on is a separate operator action.
SEEDHIBAAT_OUTBOUND_SENDING_ENABLED=false
SEEDHIBAAT_PRODUCTION_FLOW_ENABLED=false
